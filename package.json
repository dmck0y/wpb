{
  "name": "svelte-app",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 5173",
    "dev:wrangler": "wrangler pages dev --port 8788 --proxy 5173",
    "api-start": "npx wrangler pages dev dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@vitest/ui": "^3.2.4",
    "svelte": "^5.55.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "navaid": "^1.2.0",
    "svelte-history": "0.0.4"
  }
}
