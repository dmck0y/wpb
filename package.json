{
  "name": "wpb",
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run build:css && wrangler dev",
    "build": "npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/styles.css --minify",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260403.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.2.2",
    "@vitest/ui": "^3.2.4",
    "tailwindcss": "^4.1.10",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "hono": "^4.7.11"
  }
}
